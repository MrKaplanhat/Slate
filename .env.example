# Copy to .env.local for local dev, and add the same keys as
# Environment Variables in your Vercel project settings for production.
# The app works fully without any of these (mock mode) — add them when ready.

# Enables the AI Production Assistant + AI Production Brief parsing.
ANTHROPIC_API_KEY=

# Enables real call sheet emails via Resend. Without this, sends are logged
# server-side only and the UI still reports success.
RESEND_API_KEY=
EMAIL_FROM="Production OS <onboarding@resend.dev>"

# Added when Supabase is connected for real multi-tenant persistence + auth.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
